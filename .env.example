# ==========================================
# Grain Guardian - System & Hardware Settings
# ==========================================

# 1. Backend Security & JWT
# Secret key for JWT Bearer tokens (Set a long random string in production on Render)
JWT_SECRET_KEY=grain-guardian-super-secure-jwt-key-change-in-production-2026

# 2. Database Persistence
# Optional custom database path (Required if using Render Persistent Disk, e.g. /data/grain_guardian.db)
# Defaults to backend/grain_guardian.db if omitted
# DATABASE_PATH=/data/grain_guardian.db

# 3. CORS Allowed Origins
# Additional frontend origins beyond GitHub Pages and localhost (comma-separated)
# CORS_ORIGINS=https://adityaarangale.github.io,http://localhost:8000

# 4. Hardware Bridge Configuration
# Serial Port (e.g. COM3, COM4 on Windows; /dev/ttyUSB0 on Linux)
SERIAL_PORT=COM3

# Serial Baud Rate (standard sketch: 9600)
BAUD=9600

# API Ingestion Target URL
# Local: http://localhost:5000
# Production: https://grain-guardian-api.onrender.com
API_URL=http://localhost:5000

# 5. Bridge Operation Mode:
# 1 = Simulation mode (generates synthetic sensor telemetry and UV camera frames)
# 0 = Physical hardware mode (reads real Arduino / ESP32 sensor hardware)
SIMULATE=1
