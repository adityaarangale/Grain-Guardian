# ==========================================
# Grain Guardian - Hardware Bridge & System Settings
# ==========================================

# Serial Port (e.g. COM3, COM4 on Windows; /dev/ttyUSB0 on Linux)
SERIAL_PORT=COM3

# Serial Baud Rate (standard Arduino sketch: 9600)
BAUD=9600

# Backend Flask REST API Base URL
API_URL=http://localhost:5000

# Bridge Mode:
# 1 = Simulation mode (generates realistic sensor readings and synthetic UV scan frames)
# 0 = Physical hardware mode (reads real Arduino / ESP32 serial line)
SIMULATE=1
